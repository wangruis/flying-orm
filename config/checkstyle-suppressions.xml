<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<suppressions>
    <!-- core/rdb 生产代码不再豁免文件长度：V1.0.1 规划中的存量大类已经全部降到 400 行硬线以下。 -->

    <!--
        benchmark 不进入本轮大型生产类治理。真实库运行器集中声明测试场景，拆它会改变历史性能基线；
        JMH 目录则完全由注解处理器生成。这里只豁免这两类文件的行数，其他 Checkstyle 规则仍然照常检查。
    -->
    <suppress checks="FileLength" files="RealDatabasePerformanceRunner\.java"/>
    <suppress checks="FileLength" files=".*jmh_generated.*"/>

    <!-- 方法数例外只保留声明式构建器和稳定公开门面；业务实现已经下沉，不能为过门禁破坏 V1 API。 -->
    <suppress checks="MethodCount" files="SchemaMetadata\.java"/>
    <suppress checks="MethodCount" files="SyncFormClient\.java"/>
    <suppress checks="MethodCount" files="ReactiveFormRepository\.java"/>
    <suppress checks="MethodCount" files="SyncFormRepository\.java"/>
</suppressions>
