<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.wangruis</groupId>
        <artifactId>flying-orm</artifactId>
        <version>3.2.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>flying-orm-core</artifactId>
    <name>flying-orm-core</name>
    <description>Core DSL, metadata, SQL model, dialect SPI, and binding model.</description>

    <properties>
        <jacoco.line.minimum>0.40</jacoco.line.minimum>
        <jacoco.branch.minimum>0.30</jacoco.branch.minimum>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>api-compat</id>
            <activation>
                <property>
                    <name>api.compat.core.old.jar</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <api.compat.enabled>${api.compat.enabled}</api.compat.enabled>
                                <api.compat.core.old.jar>${maven.multiModuleProjectDirectory}/.tmp/upper-capability-baseline/a2785d17/flying-orm-core-3.1.0.jar</api.compat.core.old.jar>
                                <api.compat.rdb.old.jar>${maven.multiModuleProjectDirectory}/.tmp/upper-capability-baseline/a2785d17/flying-orm-rdb-3.1.0.jar</api.compat.rdb.old.jar>
                                <api.compat.core.new.jar>${project.build.directory}/${project.build.finalName}.jar</api.compat.core.new.jar>
                                <api.compat.rdb.new.jar>${maven.multiModuleProjectDirectory}/flying-orm-rdb/target/flying-orm-rdb-${project.version}.jar</api.compat.rdb.new.jar>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>com.github.siom79.japicmp</groupId>
                        <artifactId>japicmp-maven-plugin</artifactId>
                        <version>${japicmp.version}</version>
                        <executions>
                            <execution>
                                <id>compare-core-public-api</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>cmp</goal>
                                </goals>
                                <configuration>
                                    <oldVersion>
                                        <file>
                                            <path>${maven.multiModuleProjectDirectory}/.tmp/upper-capability-baseline/a2785d17/flying-orm-core-3.1.0.jar</path>
                                        </file>
                                    </oldVersion>
                                    <newVersion>
                                        <file>
                                            <path>${project.build.directory}/${project.build.finalName}.jar</path>
                                        </file>
                                    </newVersion>
                                    <outputDirectory>${project.build.directory}/japicmp/core</outputDirectory>
                                    <parameter>
                                        <accessModifier>protected</accessModifier>
                                        <onlyModified>true</onlyModified>
                                        <includeSynthetic>true</includeSynthetic>
                                        <breakBuildOnBinaryIncompatibleModifications>true</breakBuildOnBinaryIncompatibleModifications>
                                        <breakBuildOnSourceIncompatibleModifications>true</breakBuildOnSourceIncompatibleModifications>
                                        <ignoreMissingClasses>false</ignoreMissingClasses>
                                        <ignoreMissingOldVersion>false</ignoreMissingOldVersion>
                                        <ignoreMissingNewVersion>false</ignoreMissingNewVersion>
                                        <ignoreMissingOptionalDependency>false</ignoreMissingOptionalDependency>
                                    </parameter>
                                    <skipXmlReport>false</skipXmlReport>
                                    <skipHtmlReport>false</skipHtmlReport>
                                    <skipMarkdownReport>false</skipMarkdownReport>
                                    <skipDiffReport>false</skipDiffReport>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
